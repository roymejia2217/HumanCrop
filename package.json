{
  "name": "humancrop",
  "version": "1.0.0",
  "description": "High-performance desktop app designed for the automated batch processing of official ID and passport photos",
  "main": "dist/main.js",
  "author": {
    "name": "RJ Mejia"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "electron .",
    "build": "tsc",
    "test": "node --test tests/*.test.cjs && node scripts/validate-release-config.js",
    "validate:models": "node scripts/validate-model-assets.js",
    "dev": "tsc && electron .",
    "pack": "electron-builder --dir",
    "dist": "npm run validate:models && npm run build && electron-builder",
    "dist:win": "npm run validate:models && npm run build && electron-builder --win nsis",
    "dist:linux": "npm run validate:models && npm run build && electron-builder --linux AppImage --publish never && electron-builder --linux deb --publish never",
    "dist:all": "npm run validate:models && npm run build && electron-builder --win nsis --publish never && electron-builder --linux AppImage --publish never && electron-builder --linux deb --publish never",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky",
    "lint:docs": "remark README.md CONTRIBUTING.md docs/RELEASING.md --frail"
  },
  "build": {
    "appId": "com.rjmejia.humancrop",
    "productName": "HumanCrop",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*",
      "**/node_modules/onnxruntime-node/**/*"
    ],
    "afterPack": "./scripts/apply-fuses.js",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HumanCrop"
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "RJ Mejia",
      "executableName": "humancrop",
      "synopsis": "Offline AI biometric photo cropper",
      "description": "Privacy-first desktop application for offline batch processing of official ID photos using AI biometric cropping and background removal."
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "mac": {
      "target": "dmg"
    },
    "files": [
      "dist",
      "src/index.html",
      "src/styles.css",
      "src/locales",
      "src/assets",
      "node_modules"
    ]
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vladmandic/human": "^3.2.1",
    "i18next": "^25.8.13",
    "i18next-fs-backend": "^2.6.8",
    "lucide": "^0.575.0",
    "onnxruntime-node": "1.17.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@electron/fuses": "^2.1.3",
    "@types/node": "^20.0.0",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "husky": "9.1.7",
    "remark-cli": "12.0.1",
    "remark-preset-lint-consistent": "6.0.1",
    "remark-preset-lint-recommended": "7.0.1",
    "typescript": "^5.3.3"
  },
  "remarkConfig": {
    "plugins": [
      "remark-preset-lint-consistent",
      "remark-preset-lint-recommended"
    ]
  }
}
